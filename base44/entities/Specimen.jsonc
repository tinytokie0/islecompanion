{
  "name": "Specimen",
  "type": "object",
  "description": "A dinosaur specimen a player bought from the live island market with Haven Tokens (HT). Created only by the tradingBuy backend function; the owner can list and unlist it.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user id that owns this specimen"
    },
    "species": {
      "type": "string",
      "description": "Species bought from the island market"
    },
    "price_paid": {
      "type": "number",
      "description": "Haven Tokens (HT) paid at purchase time"
    },
    "listed": {
      "type": "boolean",
      "default": false,
      "description": "True while the owner has listed this specimen for trading"
    },
    "purchased_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the specimen was bought"
    }
  },
  "required": [
    "user_id",
    "species",
    "price_paid"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}