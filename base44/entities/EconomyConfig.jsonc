{
  "name": "EconomyConfig",
  "type": "object",
  "description": "Single configurable record holding the Haven Tokens reward rules and shop switch, edited by administrators from the economy dashboard.",
  "properties": {
    "earning_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master switch for playtime rewards"
    },
    "coins_per_interval": {
      "type": "number",
      "default": 10,
      "description": "Haven Tokens awarded per reward interval of verified playtime"
    },
    "interval_minutes": {
      "type": "number",
      "default": 30,
      "description": "Length of one playtime reward interval in minutes"
    },
    "max_backlog_intervals": {
      "type": "number",
      "default": 3,
      "description": "Maximum intervals of backlog awarded at once; older gaps are discarded because they were not verified live"
    },
    "feed_fresh_minutes": {
      "type": "number",
      "default": 12,
      "description": "A player only earns when their live-feed sighting is at most this many minutes old"
    },
    "shop_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master switch for the token shop"
    }
  },
  "required": [
    "earning_enabled",
    "coins_per_interval",
    "interval_minutes"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}