{
  "name": "QuestProgress",
  "type": "object",
  "description": "Per-player progress and claim state for one quest in one period. Progress is computed by backend functions from live-feed rollups; claims are validated server-side before tokens and XP are paid.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user id this progress belongs to"
    },
    "quest_id": {
      "type": "string",
      "description": "Quest id from the quest catalog"
    },
    "period": {
      "type": "string",
      "description": "Period key: daily YYYY-MM-DD, weekly YYYY-Www, monthly YYYY-MM"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "Latest computed progress toward the quest target"
    },
    "claimed": {
      "type": "boolean",
      "default": false,
      "description": "Set once the reward has been paid; never reset within the same period"
    },
    "claimed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the reward was claimed"
    }
  },
  "required": [
    "user_id",
    "quest_id",
    "period"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}