{
  "name": "BattlepassClaim",
  "type": "object",
  "description": "One claimed battlepass tier reward for a player, on the free or premium track. Created and validated only by the battlepassClaim backend function; claims never reset.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user id that claimed the reward"
    },
    "tier": {
      "type": "number",
      "description": "Battlepass tier number (1-10)"
    },
    "track": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "description": "Reward track the claim was made on"
    },
    "reward": {
      "type": "string",
      "description": "Reward name at claim time"
    },
    "claimed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the reward was claimed"
    }
  },
  "required": [
    "user_id",
    "tier",
    "track"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}