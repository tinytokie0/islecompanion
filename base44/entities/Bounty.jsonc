{
  "name": "Bounty",
  "type": "object",
  "description": "A player bounty posted with Haven Tokens: whoever kills the target in-game collects the reward. The live feed auto-settles open bounties when a linked app player takes the target down; settled bounties record the killer and the kill.",
  "properties": {
    "poster_user_id": {
      "type": "string",
      "description": "Base44 user id that posted the bounty"
    },
    "poster_name": {
      "type": "string",
      "description": "Poster's display name at post time"
    },
    "target_name": {
      "type": "string",
      "description": "In-game player name the bounty is on"
    },
    "amount": {
      "type": "number",
      "description": "HT reward for killing the target"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "collected",
        "cancelled"
      ],
      "default": "open",
      "description": "Settled by the live feed or a verified claim"
    },
    "killer_steam_id": {
      "type": "string",
      "description": "Steam ID of the player who killed the target"
    },
    "killer_name": {
      "type": "string",
      "description": "In-game name of the killer"
    },
    "collected_by_user_id": {
      "type": "string",
      "description": "Base44 user id that was paid the bounty"
    },
    "collected_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the bounty was paid"
    }
  },
  "required": [
    "poster_user_id",
    "target_name",
    "amount"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}